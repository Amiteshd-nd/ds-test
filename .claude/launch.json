{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 6173
    },
    {
      "name": "gully",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "packages/gully"
      ],
      "port": 6175
    },
    {
      "name": "personal-doc",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "personal-doc",
        "dev"
      ],
      "port": 6173,
      "autoPort": false
    },
    {
      "name": "personal-doc-alt",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "personal-doc",
        "dev",
        "--port",
        "6185"
      ],
      "port": 6185,
      "autoPort": false
    },
    {
      "name": "discovery",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "discovery",
        "dev"
      ],
      "port": 6177
    },
    {
      "name": "trimension",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@trimension/web",
        "dev"
      ],
      "port": 6178
    },
    {
      "name": "carcinogen",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "packages/carcinogen"
      ],
      "port": 6180
    },
    {
      "name": "file-compressor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "packages/file-compressor"
      ],
      "port": 6179
    },
    {
      "name": "runner",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "runner",
        "dev"
      ],
      "port": 6184,
      "autoPort": false
    },
    {
      "name": "teaser-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "render/preview.ts"
      ],
      "cwd": "packages/teaser",
      "port": 6300,
      "autoPort": false
    },
    {
      "name": "landing",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "landing",
        "dev"
      ],
      "port": 6186,
      "autoPort": false
    },
    {
      "name": "landing-email",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "landing",
        "email:preview"
      ],
      "port": 6187,
      "autoPort": false
    },
    {
      "name": "landing-prod",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "landing",
        "start"
      ],
      "port": 6186,
      "autoPort": false
    }
  ]
}
