# Runner.
#
# Every value here is optional. With none of them set the package runs entirely
# offline on development stand-ins, and the footer of the UI says so.

# --- LLM -------------------------------------------------------------------
# Set a key and the registry switches to the real provider on its own.
# ANTHROPIC_API_KEY=sk-ant-...
# Or force one: `anthropic` | `scripted`
# LLM_PROVIDER=anthropic

# --- Sandbox ---------------------------------------------------------------
# `local` is a scratch directory and a child process. It is NOT isolation, and
# the registry refuses to use it when NODE_ENV=production.
# SANDBOX_PROVIDER=local
# E2B_API_KEY=e2b_...
# E2B_TEMPLATE=base

# --- Browser ---------------------------------------------------------------
# Used for the visual QA loop and the eval suite's page checks. Chromium comes
# from `pnpm --filter runner browsers`. Set to `none` to skip the checks, which
# reports them as skipped rather than as passed.
# BROWSER_PROVIDER=none

# --- Deploy ----------------------------------------------------------------
# `local` copies the built site into .runner/deployments and serves it at
# /s/<slug>/. It is a real URL on this machine and it is not public.
# DEPLOY_PROVIDER=local
# DEPLOY_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=...          # needs "Cloudflare Pages: Edit"
# CLOUDFLARE_ACCOUNT_ID=...
# The origin local deployments are advertised at.
# RUNNER_ORIGIN=http://localhost:6184

# --- Images ----------------------------------------------------------------
# `picsum` returns a real photograph chosen at random by a seed. It is a
# stand-in, not a picture of the business. Replacing this with a generation
# provider is the single biggest quality win available.
# IMAGE_PROVIDER=picsum

# --- Search (research) -----------------------------------------------------
# Without a key the fixture provider replays recorded results for the queries
# the evals ask, and returns nothing for anything else. The research eval suite
# reports N/A rather than passing, because a suite that passes on recorded
# answers is measuring the fixtures.
# TAVILY_API_KEY=tvly-...
# SEARCH_PROVIDER=tavily

# --- Research budget -------------------------------------------------------
# Researchers run in parallel, so cost scales with the number of questions.
# RESEARCH_BUDGET_USD=1.5
# RESEARCH_PARALLEL=6

# --- Posting and emailing --------------------------------------------------
# `outbox` writes exactly what would have gone out to .runner/outbox.jsonl and
# reports it as not sent, everywhere it is shown. Nothing reaches the internet.
# Postiz is AGPL, so the integration is its HTTP API only.
# PUBLISH_PROVIDER=outbox
# POSTIZ_URL=https://postiz.example.com
# POSTIZ_API_KEY=...
# Map our platform names onto Postiz integration ids from its own UI.
# POSTIZ_CHANNELS=x:abc123,linkedin:def456
#
# EMAIL_PROVIDER=outbox
# RESEND_API_KEY=re_...
# EMAIL_FROM="Tom Wexford <tom@kestrelhedgelaying.co.uk>"
# Before switching this on: the sending domain needs SPF, DKIM and DMARC, or
# the business's real mail starts going to spam.

# --- Scheduling ------------------------------------------------------------
# How often the ticker looks for approved, due items. Nothing fires while
# Runner is not running; it catches up on the first request after a restart.
# SCHEDULER_TICK_MS=60000

# --- Credits and quotas ----------------------------------------------------
# What a free-tier account gets each calendar month. PRD section 12.3, set by
# the owner. Grants are idempotent per user per month.
# FREE_TIER_USD=5
#
# `local` adds credit straight to the ledger and takes no payment; every
# surface says so. Stripe credits on the webhook, never on the success
# redirect - a browser arriving at a page is not a payment settling.
# BILLING_PROVIDER=local
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Tracing ---------------------------------------------------------------
# `jsonl` writes .runner/traces/YYYY-MM-DD.jsonl. `none` disables it.
# Langfuse (PRD section 6.8) is not wired up yet - see DECISIONS.md.
# TRACE_SINK=jsonl

# --- Local state -----------------------------------------------------------
# RUNNER_DB=.runner/runner.db
# RUNNER_DEV_USER=owner@localhost
# Keep task sandboxes on disk after a run, for debugging.
# RUNNER_KEEP_SANDBOX=1
