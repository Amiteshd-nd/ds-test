{
  "name": "runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Runner \u2014 the general small-business agent (PRD codename \"Forge\"). Phase 0: thin agent loop, swappable providers, streamed progress.",
  "scripts": {
    "dev": "next dev -p 6184",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -p 6184",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance": "node --experimental-strip-types scripts/acceptance.ts",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "seed": "node scripts/seed-template.ts",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cloud-march/motion": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
