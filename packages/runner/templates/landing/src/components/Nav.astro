---
/**
 * Layout family: sticky single-line bar.
 *
 * One line at desktop, 64px, no exceptions. The mobile fallback is not a
 * hamburger: a four-item nav on a service-business page is better as a scrolling
 * strip than behind a tap nobody makes.
 */
import { site } from '../site';
---

<header
  class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6"
    aria-label="Primary"
  >
    <a href="#main" class="font-display text-[15px] font-semibold tracking-tight shrink-0">
      {site.brand.name}
    </a>

    <ul
      class="ml-auto hidden items-center gap-6 text-sm text-muted md:flex"
      role="list"
    >
      {
        site.nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors duration-150 hover:text-ink focus-visible:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={site.cta.href}
      class="ml-auto whitespace-nowrap rounded-control bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-transform duration-150 active:translate-y-px md:ml-0"
    >
      {site.cta.label}
    </a>
  </nav>
</header>
