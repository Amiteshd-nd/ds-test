# Copy this file to .env.local and fill in your KIRI Engine API key.
# Create a developer account + key at https://www.kiriengine.app  (Settings -> API)
# Key format looks like: kiri-xxxxxxxxxxxxxxxx

KIRI_API_KEY=kiri-your-key-here

# Optional — override only if KIRI changes their base URL.
KIRI_BASE_URL=https://api.kiriengine.app/api

# Scan tuning (optional). Defaults are the highest quality.
# modelQuality:   0 High (default), 1 Medium, 2 Low, 3 Ultra
# textureQuality: 0 4K (default),   1 2K,      2 1K,  3 8K
KIRI_MODEL_QUALITY=0
KIRI_TEXTURE_QUALITY=0
