{
  "name": "@cloud-march/game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/game.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-maps.mjs && node scripts/validate-content.ts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:maps": "node scripts/validate-maps.mjs",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.ts",
    "validate": "node scripts/validate-maps.mjs && node scripts/validate-content.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "types": "src/index.ts"
}
