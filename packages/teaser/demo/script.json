  "audio": {
    "$comment": "Gains are linear, pre-normalisation; 0 mutes a cue. Typing is silent on purpose (typewriter 0); the send bell is kept very quiet. Cues come from out/events.json, written by the capture from the timeline. The bed is synthesised unless assets/music.(mp3|wav|m4a|aac) exists, which assemble.sh then mixes in at musicGainDb instead.",
    "targetLufs": -18,
    "typewriter": {
      "gain": 0.0
    },
    "bell": {
      "gain": 0.06
    },
    "pop": {
      "gain": 0.14
    },
    "chime": {
