{
  "name": "US National CAD Standard (default)",
  "default_wall_height_mm": 2700,
  "default_wall_thickness_mm": 100,
  "heal_tolerance_mm": 5,
  "rules": [
    {
      "id": "ignored.layer.reference",
      "because": "hatch outlines and room boundaries restate geometry that is already drawn; importing them again would count every wall and room twice",
      "match": {
        "on": "any",
        "value": [
          {
            "on": "layer",
            "how": "glob",
            "value": "*-PATT*"
          },
          {
            "on": "layer",
            "how": "glob",
            "value": "*-FURN*"
          }
        ]
      },
      "becomes": "ignored",
      "weight": 500,
      "confidence": "strong"
    },
    {
      "id": "wall.layer.ncs",
      "because": "layer name matches the NCS wall convention (A-WALL*)",
      "match": {
        "on": "layer",
        "how": "glob",
        "value": "*-WALL*"
      },
      "becomes": "wall",
      "weight": 400,
      "confidence": "strong"
    },
    {
      "id": "wall.layer.plain",
      "because": "layer is literally named WALL",
      "match": {
        "on": "layer",
        "how": "equals",
        "value": "WALL"
      },
      "becomes": "wall",
      "weight": 400,
      "confidence": "strong"
    },
    {
      "id": "door.layer.ncs",
      "because": "layer name matches the NCS door convention (A-DOOR*)",
      "match": {
        "on": "layer",
        "how": "glob",
        "value": "*-DOOR*"
      },
      "becomes": "door",
      "weight": 400,
      "confidence": "strong"
    },
    {
      "id": "window.layer.ncs",
      "because": "layer name matches the NCS glazing convention (A-GLAZ*)",
      "match": {
        "on": "layer",
        "how": "glob",
        "value": "*-GLAZ*"
      },
      "becomes": "window",
      "weight": 400,
      "confidence": "strong"
    },
    {
      "id": "window.layer.plain",
      "because": "layer name contains WINDOW",
      "match": {
        "on": "layer",
        "how": "contains",
        "value": "WINDOW"
      },
      "becomes": "window",
      "weight": 390,
      "confidence": "strong"
    },
    {
      "id": "annotation.layer.ncs",
      "because": "NCS annotation group (A-ANNO*), including text and dimensions",
      "match": {
        "on": "layer",
        "how": "glob",
        "value": "*-ANNO*"
      },
      "becomes": "annotation",
      "weight": 400,
      "confidence": "strong"
    },
    {
      "id": "ignored.layer.grid",
      "because": "column grid and construction lines are reference, not fabric",
      "match": {
        "on": "any",
        "value": [
          {
            "on": "layer",
            "how": "glob",
            "value": "*-GRID*"
          },
          {
            "on": "layer",
            "how": "equals",
            "value": "DEFPOINTS"
          },
          {
            "on": "layer",
            "how": "glob",
            "value": "*VIEWPORT*"
          }
        ]
      },
      "becomes": "ignored",
      "weight": 450,
      "confidence": "strong"
    },
    {
      "id": "door.block.name",
      "because": "inserted block is named like a door",
      "match": {
        "on": "all",
        "value": [
          {
            "on": "geometry",
            "value": "is_block_reference"
          },
          {
            "on": "any",
            "value": [
              {
                "on": "block_name",
                "how": "contains",
                "value": "DOOR"
              },
              {
                "on": "block_name",
                "how": "starts_with",
                "value": "D-"
              },
              {
                "on": "block_name",
                "how": "glob",
                "value": "DR?*"
              }
            ]
          }
        ]
      },
      "becomes": "door",
      "weight": 300,
      "confidence": "strong"
    },
    {
      "id": "window.block.name",
      "because": "inserted block is named like a window",
      "match": {
        "on": "all",
        "value": [
          {
            "on": "geometry",
            "value": "is_block_reference"
          },
          {
            "on": "any",
            "value": [
              {
                "on": "block_name",
                "how": "contains",
                "value": "WIN"
              },
              {
                "on": "block_name",
                "how": "contains",
                "value": "GLAZ"
              }
            ]
          }
        ]
      },
      "becomes": "window",
      "weight": 300,
      "confidence": "strong"
    },
    {
      "id": "annotation.text",
      "because": "text and mtext entities are annotation wherever they sit",
      "match": {
        "on": "geometry",
        "value": "is_text"
      },
      "becomes": "annotation",
      "weight": 250,
      "confidence": "strong"
    },
    {
      "id": "ignored.linetype.dashed",
      "because": "dashed and centre linetypes conventionally mark reference geometry",
      "match": {
        "on": "any",
        "value": [
          {
            "on": "line_type",
            "how": "contains",
            "value": "DASHED"
          },
          {
            "on": "line_type",
            "how": "contains",
            "value": "CENTER"
          },
          {
            "on": "line_type",
            "how": "contains",
            "value": "HIDDEN"
          }
        ]
      },
      "becomes": "ignored",
      "weight": 200,
      "confidence": "weak"
    },
    {
      "id": "wall.lineweight.heavy",
      "because": "heavy lineweight is the traditional wall convention on unlayered drawings",
      "match": {
        "on": "all",
        "value": [
          {
            "on": "line_weight_at_least",
            "value": 50
          },
          {
            "on": "geometry",
            "value": "longer_than_mm",
            "extra": 0
          }
        ]
      },
      "becomes": "wall",
      "weight": 200,
      "confidence": "weak"
    },
    {
      "id": "wall.geometry.long_line",
      "because": "last resort: a long straight run on an unrecognised layer is probably a wall",
      "match": {
        "on": "all",
        "value": [
          {
            "on": "geometry",
            "value": "open_two_point"
          },
          {
            "on": "geometry",
            "value": "longer_than_mm",
            "extra": 800
          }
        ]
      },
      "becomes": "wall",
      "weight": 100,
      "confidence": "weak"
    }
  ]
}