# Copy to .env.local. Nothing here is required for scripted runs.

# Sarvam key, server-side only — never NEXT_PUBLIC_. Without it, POST /api/agent
# with { live: true } returns 501 and every timing in the UI stays labelled a
# placeholder. This is docs/build-workflow.md §2 step 4, the cheapest high-value
# thing left in the program.
# SARVAM_API_KEY=

# Set to 1 to hide all the scaffolding — the fault toolbar and the surface switcher —
# for a user-test session where a participant poking at either would contaminate the
# run. Leave unset for development and for demos, where the fault toolbar IS the demo.
# NEXT_PUBLIC_HIDE_DEV_CHROME=1
