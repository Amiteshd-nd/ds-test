# Resend API key (https://resend.com/api-keys). Sending access is enough.
# Leave empty in development: the action logs what it would have done and succeeds.
RESEND_API_KEY=

# Where signups are stored. Resend renamed Audiences to Segments in late 2025;
# an old Audience ID is a Segment ID now, so either works here.
RESEND_AUDIENCE_ID=

# Must be on a domain you have verified in Resend.
EMAIL_FROM="Gazebo <hello@gazebo.example>"

# Absolute origin, no trailing slash. Used for canonical URL and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:6186
